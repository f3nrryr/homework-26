@startuml Sequence_SendMessage
!theme plain
skinparam shadowing false
title Отправка и доставка (с маршрутизацией WS)
actor Sender
participant GW1 as "Gateway-1\n(отправитель)"
participant Msg as "Messages"
participant CAS as "Cassandra"
participant Kafka
participant Pres as "Presence"
database Redis
participant GW2 as "Gateway-2\n(получатель)"
actor Peer as "Получатель"
participant Push as "Push"

Sender -> GW1 : POST /messages\nIdempotency-Key
GW1 -> Msg : gRPC Send
Msg -> CAS : INSERT messages_by_chat
Msg -> Kafka : MessageSent key=chat_id
Msg --> GW1 : 201 messageId
GW1 --> Sender : 201

Kafka -> Pres : consume
Pres -> Redis : SMEMBERS ws:user:{peer}
alt есть живые сессии
  Redis --> Pres : [{node:GW2, device:d1}, ...]
  Pres -> Redis : PUBLISH gw:GW2
  Redis -> GW2 : payload + conn_id
  GW2 -> Peer : WS message.created
else сессий нет
  Kafka -> Push : consume
  Push -> Push : APNs / FCM
end

note over Redis
  На WS-connect Gateway пишет
  HSET ws:user:{id} {device_id} → gw_node
  TTL обновляет heartbeat.
  Несколько устройств = несколько записей.
end note
@enduml
